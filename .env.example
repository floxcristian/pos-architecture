# Configure these on Vercel, never in client JavaScript. No real credentials belong here.
# Keep disabled until the provider and a blocking @vercel/firewall rate-limit rule are ready.
POS_ASSISTANT_ENABLED=false
OPENAI_API_KEY=
# Choose a model that supports the Responses API and strict JSON Schema output.
OPENAI_MODEL=
# Exact ID of the published Vercel WAF SDK rule (not a rule in log-only mode).
POS_ASSISTANT_RATE_LIMIT_ID=
# Set NODE_ENV explicitly for this framework-free server deployment.
NODE_ENV=production
# Enable access to Vercel System Environment Variables so VERCEL=1 is available.
# Local verification uses injected test doubles and never calls an LLM.
