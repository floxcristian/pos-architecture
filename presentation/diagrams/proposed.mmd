flowchart LR
    accTitle: Propuesta de POS con operación local e integración posterior
    accDescr: El backend de sucursal NestJS y Fastify evalúa precios sobre un espejo de PostgreSQL y guarda ventas y outbox en una transacción. Central recibe en PostgreSQL por país; una ACL integra el ERP. Los eventos y las cargas programadas o manuales actualizan el espejo. Arquitectura propuesta.
    subgraph branch["Sucursal · propuesta"]
        direction TB
        tauri["Cliente de caja<br/>Angular + Tauri"] -->|"HTTPS / LAN"| edge["Backend de sucursal<br/>NestJS + Fastify"]
        edge -->|"Evaluar versión activa"| offers["Precios y ofertas<br/>Espejo local + motor"]
        subgraph tx["Una base · un commit"]
            direction LR
            edgedb[("PostgreSQL de sucursal<br/>Ventas, caja y pagos")]
            outbox["Outbox<br/>pendientes"]
            edgedb ~~~ outbox
        end
        edge --> tx
        offers ~~~ tx
    end
    subgraph central["Integración central"]
        direction TB
        inbox["Inbox / PostgreSQL país<br/>recepción durable"] --> platform["Backend y workers del país<br/>NestJS + Fastify"]
        platform --> acl["ACL<br/>por ERP"]
        acl --> erp[("ERP<br/>por país")]
    end
    outbox -->|"HTTPS / eventos"| inbox
    platform -->|"Eventos y cargas masivas<br/>programadas o manuales"| offers
